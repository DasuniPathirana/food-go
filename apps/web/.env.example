# Deployment guide: docs/deployment/README.md and docs/deployment/environment.md.
# Website data comes from Supabase. The historical example routes are retired.
# Supply the project and origin values, then enable the connected release flags.
# Never paste actual keys, passwords or signing secrets into chat or commit them.
FOOD_GO_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate at least 32 random bytes and encode as base64url on the server.
FOOD_GO_AUTH_COOKIE_SECRET=
# Set true on the configured production origin and verify signup and confirmation.
FOOD_GO_AUTH_PRODUCTION_READY=false
# Must be an exact origin without a trailing slash. Production requires HTTPS.
# Replace this loopback value with the stable deployed origin in hosting settings.
# Do not infer it from an untrusted Host/Origin request header or an arbitrary preview URL.
APP_ORIGIN=http://127.0.0.1:3000
# Public catalogue is independent of account registration. Choose demo or supabase.
# Supabase mode shows only approved listings; it never falls back to examples.
FOOD_GO_CATALOGUE_MODE=supabase
# Public community reads need the community migration. Writes additionally require
# the existing verified-account release gates; new public posts await moderation.
FOOD_GO_COMMUNITY_ENABLED=false
# Private coarse discovery cells. Requires its migration and verified auth gates.
# Recording still needs explicit consent each mounted Explore session.
FOOD_GO_EXPLORATION_ENABLED=false
# Approved restaurant pools, private inventory and purpose-bound staff codes.
# Apply encounter migration and pass owner/operator/account acceptance first.
FOOD_GO_ENCOUNTERS_ENABLED=false
# Requires a verified account (email or AU mobile) and the partner draft migration.
FOOD_GO_PARTNER_ENABLED=false
# Phone sign-in uses the Supabase SMS hook and Australian mobile numbers.
FOOD_GO_PHONE_AUTH_ENABLED=false
FOOD_GO_SMS_ENABLED=false
# Brevo REST delivery via the signed Supabase Send Email Hook, independent of SMTP.
# Keep false until the intended HTTPS hook and verified sender are configured.
FOOD_GO_EMAIL_ENABLED=false
SUPABASE_EMAIL_HOOK_SECRET=
BREVO_API_KEY=
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=
SUPABASE_SMS_HOOK_SECRET=
MOBILE_MESSAGE_API_USERNAME=
MOBILE_MESSAGE_API_PASSWORD=
MOBILE_MESSAGE_SENDER_ID=

# Worldwide streets use OpenFreeMap without a key. Optional global satellite:
# One public MapTiler key handles browser imagery and browser place search.
# Restrict it to allowed origins and supply it before build. The selected setup
# allows food-go-three.vercel.app, localhost and 127.0.0.1, one hostname per line.
# Without it, the satellite/aerial overlays cover Melbourne CBD only.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional private key for server-side search where a separate key is available.
# Leave unset for the current one-key browser setup; never copy the browser key
# here or add NEXT_PUBLIC_. See docs/deployment/setup-now.md.
MAPTILER_SERVER_KEY=
# Optional server secret for the supported openrouteservice foot-walking API.
# Current provider host: api.heigit.org/openrouteservice/v2.
# Without it, the public FOSSGIS foot service is used with a shared 1.1s lease.
OPENROUTESERVICE_API_KEY=
# Optional HTTPS endpoints for your own Photon geocoder and OSRM foot router.
# Never point FOOT_ROUTER_ENDPOINT at a driving-only routing service.
FOOD_GO_PHOTON_ENDPOINT=
FOOD_GO_FOOT_ROUTER_ENDPOINT=
