# Deployment guide: docs/deployment/README.md and docs/deployment/environment.md.
# The /demo browser experience works with every service flag below left false.
# No account service is enabled until its values AND release gates are complete.
# Never paste actual keys, passwords or signing secrets into chat or commit them.
FOOD_GO_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate at least 32 random bytes and encode as base64url on the server.
FOOD_GO_AUTH_COOKIE_SECRET=
# Set true only after all identity production gates have been implemented and tested.
FOOD_GO_AUTH_PRODUCTION_READY=false
# Must be an exact origin without a trailing slash. Production requires HTTPS.
# Replace this loopback value with the stable deployed origin in hosting settings.
# Do not infer it from an untrusted Host/Origin request header or an arbitrary preview URL.
APP_ORIGIN=http://127.0.0.1:3000
# Public catalogue is independent of account registration. Choose demo or supabase.
# Supabase mode shows only approved listings; it never falls back to examples.
FOOD_GO_CATALOGUE_MODE=demo
# Public community reads need the community migration. Writes additionally require
# the existing verified-account release gates; new public posts await moderation.
FOOD_GO_COMMUNITY_ENABLED=false
# Requires a verified account (email or AU mobile) and the partner draft migration.
FOOD_GO_PARTNER_ENABLED=false
# Phone sign-in uses the Supabase SMS hook and Australian mobile numbers.
FOOD_GO_PHONE_AUTH_ENABLED=false
FOOD_GO_SMS_ENABLED=false
SUPABASE_SMS_HOOK_SECRET=
MOBILE_MESSAGE_API_USERNAME=
MOBILE_MESSAGE_API_PASSWORD=
MOBILE_MESSAGE_SENDER_ID=
